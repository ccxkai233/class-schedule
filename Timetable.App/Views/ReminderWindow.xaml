<Window x:Class="Timetable.App.Views.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Timetable.App.Views"
        xmlns:vm="clr-namespace:Timetable.App.ViewModels"
        mc:Ignorable="d"
        Title="提醒" Height="150" Width="350"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True"
        d:DataContext="{d:DesignInstance vm:ReminderViewModel}">
    <Border Background="#3E3E42" CornerRadius="8" Margin="10" BorderBrush="Gray" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="1" Color="Black" Opacity="0.4" BlurRadius="10"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" Margin="15,15,15,5" Foreground="White"/>

            <TextBlock Grid.Row="1" Text="{Binding Message}" Margin="15,5,15,15" VerticalAlignment="Center" Foreground="White" TextWrapping="Wrap"/>
        </Grid>
    </Border>
</Window>